# Copie ce fichier en 'glpi.env' puis remplis tes valeurs :
#   cp glpi.env.exemple glpi.env
# 'glpi.env' contient des secrets : il ne doit jamais etre versionne (voir .gitignore).

# URL de l'API REST de ton serveur GLPI.
# Mets https:// si ton serveur est en HTTPS (les scripts acceptent le certificat auto-signe).
export GLPI_URL="https://192.168.70.10/apirest.php"

# Jeton d'application, genere dans GLPI : Configuration > Generale > API > client API.
export APP_TOKEN="colle_ici_ton_app_token"

# Jeton du compte de service 'automate' : sa cle d'acces distant, dans ses preferences.
export USER_TOKEN="colle_ici_ton_user_token"
